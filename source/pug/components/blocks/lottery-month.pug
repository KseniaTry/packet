mixin lottery-month()

  -
    const lotteryMonthCards = [
      {
        period: "От 3 до 6 месяцев",
        titleColor: "#4891D3",
        backgroundColor: "#e1edff 0%, #e3f2ff 0.01%",
        cards: [
          {
            title: "Телевизоры 65”",
            text: "От 3 до 6 месяцев",
            backgroundColor: "#FCCCE8",
            includeExtraInfo: false,
            includeInfoIcon: true,
            memberLogoSrc: "img/content/members-logo/citilink-logo.svg",
            memberLogoWidth: 104,
            memberLogoHeight: 24,
            memberLogoAlt: "Логотип Ситилинк",
            imagePath: "slides/lottery-month/slide1",
            imageName: "tv",
            imageType: "png",
            imageAlt: "Изображение телевизора",
          },
          {
            title: "3000 баллов<br> «X5 Клуба»",
            text: "От 3 до 6 месяцев",
            backgroundColor: "#a6f4ff",
            includeExtraInfo: true,
            extraInfo: "300 призов",
            extraInfoColor: "#2CA7AF",
            includeInfoIcon: false,
            memberLogoSrc: "img/content/members-logo/x5-logo.svg",
            memberLogoWidth: 28,
            memberLogoHeight: 24,
            memberLogoAlt: "Логотип X5",
            imagePath: "slides/lottery-month/slide2",
            imageName: "stars",
            imageType: "png",
            imageAlt: "Изображение улыбающейся зеленой звезды",
          }
        ]
      },
      {
        period: "Больше<br> 6 месяцев",
        titleColor: "#498AE9",
        backgroundColor: "#e1edff 0%",
        cards: [
          {
            title: "Пылесосы",
            text: "Больше 6 месяцев",
            backgroundColor: "#C5BCFF",
            includeExtraInfo: false,
            includeInfoIcon: true,
            memberLogoSrc: "img/content/members-logo/citilink-logo.svg",
            memberLogoWidth: 104,
            memberLogoHeight: 24,
            memberLogoAlt: "Логотип Ситилинк",
            imagePath: "slides/lottery-month/slide3",
            imageName: "vacum-cleaner",
            imageType: "png",
            imageAlt: "Изображение беспроводного пылесоса",
          },
          {
            title: "3000 баллов<br> «X5 Клуба»",
            text: "Больше 6 месяцев",
            backgroundColor: "#b6e3fd",
            includeExtraInfo: true,
            extraInfo: "300 призов",
            extraInfoColor: "#50A8D9",
            includeInfoIcon: false,
            memberLogoSrc: "img/content/members-logo/x5-logo.svg",
            memberLogoWidth: 28,
            memberLogoHeight: 24,
            memberLogoAlt: "Логотип X5",
            imagePath: "slides/lottery-month/slide4",
            imageName: "coin",
            imageType: "png",
            imageAlt: "Изображение улыбающейся золотой монеты",
          }
        ]
      },
    ]

  section.lottery-month
    +lottery-block(lotteryMonthCards, "Разыгрываем<br> в сентябре")
    .container.lottery-month__form-wrapper
      form.lottery-month__form
        .custom-checkbox.lottery-month__checkbox-wrapper
          input(type="checkbox" id="agreement-2" name="agreement-2" data-class="agreement-input" required).custom-checkbox__input.lottery-month__input
          label(for="argeement").custom-checkbox__label.lottery-month__label
            |Я согласен на
            a(href="#").custom-checkbox__link
              p участие в акции
        button.btn.lottery-month__button(type="button", aria-label="Принять участие")= "Принять участие"

