mixin hero(title, pageName)
  section.hero
    .hero__background-wrapper(data-class=`hero-${pageName}-background`, data-animation="hero-background")
      .hero__background-desktop(data-class=`hero-${pageName}-background-desktop`)
        +img("content/hero/background", "background-desktop", "png", 1440, 655, "")
      .hero__background-mobile
        +img("content/hero/background", "background-mobile", "png", 375, 480, "")
    .container.hero__main-wrapper
      h1.visually-hidden Пакет - считаем баллы, чтобы выиграть призы
      .hero__title-wrapper
        h2= title
      if pageName === "index"
        +hero-main-text()
      if pageName === "winners"
        +hero-search-form()
      .hero__image-wrapper(data-class=`hero-${pageName}-image`, data-animation="hero-image")
        +img("content/hero", "goods", "png", 654, 649, "Изображение товаров бытовой техники")

