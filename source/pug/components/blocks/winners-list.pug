mixin winners-list()

  -
    const winnersList = [
      {
        period: "02.08.23 — первый розыгрыш",
        isActive: true,
        id: 1,
      },
      {
        period: "09.08.23 — второй розыгрыш",
        isActive: false,
        id: 2,
      },
      {
        period: "16.08.23 — третий розыгрыш",
        isActive: false,
        id: 3,
      },
      {
        period: "23.08.23 — четвертый розыгрыш",
        isActive: false,
        id: 4,
      },
      {
        period: "30.08.23 — пятый розыгрыш",
        isActive: false,
        id: 5,
      },
      {
        period: "07.09.23 — шестой розыгрыш",
        isActive: false,
        id: 6,
      },
      {
        period: "14.09.23 — седьмой розыгрыш",
        isActive: false,
        id: 7,
      }
    ]

  section.winners-list
    .container.winners-list__main-wrapper
      h2 Список победителей
      .winners-list__buttons-wrapper
        +btn({tag: "button", text: "Еженедельные", type: "button"}).winners-list__button
        +btn({tag: "button", text: "Розыгрыш в сентябре", type: "button"}).winners-list__button
      form.winners-list__form
        .new-custom-select(data-class="custom-select-wrapper")
          for winners in winnersList
            if winners.isActive
              input(type="text" id="periods" name="periods" autocomplete="off" data-class="custom-input" value=winners.period required readonly).new-custom-select__input
          label(for="periods" data-class="custom-label").new-custom-select__label
          .new-custom-select__icon-wrapper
            +icon("arrow", 10, 10)
          .new-custom-select__select(data-class="custom-select")
            for winners in winnersList
              .new-custom-select__option(data-id=winners.id data-class="custom-option" data-active=`${winners.isActive ? "is-active" : "not-active"}`)= winners.period
      p(data-class="no-winners-msg").winners-list__no-winners-msg Победители еще не определены
      .winners-list__list-wrapper(data-class="winners-list-wrapper")
        p.winners-list__week(data-class="winners-week")
        p.winners-list__dates(data-class="winners-dates")
        table.winners-list__table
          thead.winners-list__thead
            tr.winners-list__title-wrapper
              th.winners-list__title.winners-list__title--name Имя
              th.winners-list__title.winners-list__title--phone Телефон
              th.winners-list__title.winners-list__title--prize Приз
          tbody.winners-list__tbody(data-class="winners-list")

