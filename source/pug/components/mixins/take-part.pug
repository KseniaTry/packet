mixin take-part(className)

  .take-part(data-class= `take-part-${className}`)
    form.take-part__form
      .take-part__custom-checkbox.custom-checkbox
        input(type="checkbox" id="agreement-2" name="agreement-2" data-class="agreement-input" required).custom-checkbox__input
        label(for="argeement-2").custom-checkbox__label
          |Я согласен на
          a(href="#").custom-checkbox__link
            p участие в акции
      button.take-part__button.btn(type="button", aria-label="Принять участие")= "Принять участие"
