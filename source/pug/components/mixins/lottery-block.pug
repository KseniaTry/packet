mixin lottery-block(lotteryCards, title)

  .lottery
    .container.lottery__main-wrapper
      h2(data-class="lottery-title")!= title
      .lottery__period-cards-wrapper
        for item in lotteryCards
          .lottery__period-wrapper(data-class="period-wrapper" data-background-color=item.backgroundColor)
            .lottery__title-wrapper(data-class="period-title-wrapper" data-color=item.titleColor)
              h3(data-class="lottery-period")!= item.period
            .lottery__swiper(data-class="lottery-swiper")
              .lottery__swiper-wrapper(data-class="lottery-swiper-wrapper")
                for card in item.cards
                  +lottery-card(card)
