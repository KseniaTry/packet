mixin header(headerMods, currentUrl)
  header.header(class=headerMods)
    .container.header__main-wrapper
      if(currentUrl === "index.html")
        //- lighthouse снимает 10 баллов SEO за <a> без href
        span.header__logo
          span.header__logo-desktop
            img(src="img/content/logo/logo-desktop.svg", width="162", height="28", alt="Логотип Пакет")
          span.header__logo-mobile
            img(src="img/content/logo/logo-mobile.svg", width="116", height="19", alt="Логотип Пакет")
      else
        a.header__logo(href="index.html", aria-label="Переход на главную")
          span.header__logo-desktop
            img(src="img/content/logo/logo-desktop.svg", width="162", height="28", alt="Логотип Пакет")
          span.header__logo-mobile
            img(src="img/content/logo/logo-mobile.svg", width="116", height="19", alt="Логотип Пакет")

